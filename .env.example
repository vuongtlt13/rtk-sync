# Optional RTK tracking database path override.
# Leave this commented to auto-detect the same OS-specific default as RTK:
# dirs::data_local_dir()/rtk/history.db
# macOS example: ~/Library/Application Support/rtk/history.db
# Linux example: ~/.local/share/rtk/history.db
# RTK_SYNC_DB="/path/to/rtk/history.db"

# Sync API endpoint. Overrides endpoint in config.toml. HTTPS is required by default.
RTK_SYNC_ENDPOINT="https://example.com/api/rtk/events"

# Bearer token used for Authorization: Bearer <token>.
# You can store token in config.toml with: rtk-sync config --token <token>
# Or keep it outside config and use token_env; default is RTK_SYNC_TOKEN.
RTK_SYNC_TOKEN="replace-me"

# Optional stable machine ID override. If unset, rtk-sync derives one from local machine info and stores it in state.
# RTK_SYNC_MACHINE_ID="macbook-vuong"

# Optional batch size. Defaults to 100.
RTK_SYNC_BATCH_SIZE="100"

# Optional state file path. If unset, rtk-sync uses dirs::data_local_dir()/rtk-sync/state.json
# macOS example: ~/Library/Application Support/rtk-sync/state.json
# Linux example: ~/.local/share/rtk-sync/state.json
# RTK_SYNC_STATE="/path/to/rtk-sync/state.json"
